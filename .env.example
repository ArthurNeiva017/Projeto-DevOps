# Copie para .env (na raiz do projeto) e preencha. O .env NUNCA deve ser commitado.
# Na pipeline estes valores vêm dos GitHub Secrets dos environments homologacao/producao.

# E-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fontes de inteligência
RANSOMWARE_LIVE_API_KEY=
CVEFEED_API_KEY=

# Microsoft Teams
TEAMS_WEBHOOK_URL=

# Docker Compose (opcionais)
# IMAGE_NAME=ghcr.io/arthurneiva017/projeto-devops
# IMAGE_TAG=1.0.0
# HTTP_PORT=3002
# SIMULATE_FAILURE=false
