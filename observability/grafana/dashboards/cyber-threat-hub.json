    {
      "type": "timeseries",
      "id": 15,
      "title": "Taxa de erros",
      "description": "Percentual de respostas 4xx (erro do cliente) e 5xx (erro do servidor).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"cyber-threat-hub\", status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{job=\"cyber-threat-hub\", route!=\"/metrics\"}[$__rate_interval])), 1e-9)",
